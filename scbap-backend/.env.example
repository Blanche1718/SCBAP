# Backend development environment
# Copy this file to .env.development for local development

NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/scbap
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DAPG Info
DAPG_BASE_URL=https://pprod-amenagementdepeine.justice.bj/api
DAPG_API_KEY=ask-albert-for-dapg-api-key

# MinIO local development
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=scbap-documents
MINIO_REGION=us-east-1

# JWT secrets
JWT_SECRET=change-me-with-a-long-random-secret-at-least-32-chars
PORTAIL_JWT_SECRET=change-me-with-a-different-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=12h
PORTAIL_JWT_EXPIRES_IN=12h

# Security & cookies
AUTH_COOKIE_NAME=scbap_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE_MS=43200000

# Rate limiting
BCRYPT_ROUNDS=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=SCBAP
MAIL_REPLY_TO=

# External services
BIOMETRIE_API_BASE_URL=http://pprod-fingerprints.justice.bj
BIOMETRIE_API_KEY=
BIOMETRIE_APPLICATION=siope
BIOMETRIE_DEEP_LINK_APP=
BIOMETRIE_MANY=yes
BIOMETRIE_TIMEOUT_MS=30000
BIOMETRIE_DEBUG=false
NFC_DETENUS_URL=http://172.17.57.95:50049/api/detenus/all
NFC_TIMEOUT_MS=60000

MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=scbap-backend-dev
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=scbap/bracelets/telemetry
MQTT_EVENTS_TOPIC=scbap/bracelets/events
MQTT_STATUS_TOPIC=scbap/bracelets/status
MQTT_CONFIG_TOPIC=scbap/bracelets/config
MQTT_DEBUG=true

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=

# Webhook security
WEBHOOK_SECRET=change-me-with-a-long-random-webhook-secret

# Logging
LOG_LEVEL=debug

# HTTPS only in production
HTTPS=false

APP_TIME_ZONE=Africa/Porto-Novo
PORTAIL_BASE_URL=http://localhost:5173/portail
DEFAULT_USER_PASSWORD=change_me
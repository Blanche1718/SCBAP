generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================
// STRUCTURE
// =====================

model Structure {
  id          String   @id @default(uuid())
  nom         String
  code        String   @unique
  type        String // PRISON, COMMISSARIAT, SPIP, TRIBUNAL, MAIRIE...
  juridiction String?
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("structures")
}

// =====================
// JURIDICTION
// =====================

model Juridiction {
  id        String   @id
  nom       String
  createdAt DateTime @default(now()) @map("created_at")

  dossiers Dossier[]

  @@map("juridictions")
}

// =====================
// ROLES & USERS
// =====================

model Role {
  id  String @id @default(uuid())
  nom String

  users User[]

  @@map("roles")
}

model User {
  id          String   @id @default(uuid())
  nom         String
  prenom      String
  email       String   @unique
  telephone   String?
  motDePasse  String   @map("mot_de_passe")
  roleId      String   @map("role_id")
  structureId String   @map("structure_id")
  statut      String // ACTIF, INACTIF, SUSPENDU
  createdAt   DateTime @default(now()) @map("created_at")

  role      Role      @relation(fields: [roleId], references: [id])
  structure Structure @relation(fields: [structureId], references: [id])

  pointages            Pointage[]
  demandesTraitees     DemandeAutorisation[]
  justificatifsValides Justificatif[]
  rapports             Rapport[]
  notifications        Notification[]
  historiquesActions   HistoriqueAction[]
  obligationsModifiees Obligation[]          @relation("ObligationModifiePar")

  @@map("users")
}

// =====================
// DOSSIER (source métier — fournie par API externe)
// =====================

model Dossier {
  id                String    @id @default(uuid())
  numeroDossier     String    @unique @map("numero_dossier")
  juridictionId     String?   @map("juridiction_id")
  prisonId          String?   @map("prison_id")
  prisonName        String?   @map("prison_name")
  nom               String
  prenom            String
  dateNaissance     DateTime? @map("date_naissance") @db.Date
  lieuNaissance     String?   @map("lieu_naissance")
  nationalite       String?
  sexe              String? // M, F
  profession        String?
  adresse           String?
  telephoneContact  String?   @map("telephone_contact")
  infractions       String?
  numeroMandatDepot String    @map("numero_mandat_depot")
  dateMandatDepot   DateTime? @map("date_mandat_depot") @db.Date
  condamnation      String?
  dateFinPeine      DateTime? @map("date_fin_peine") @db.Date
  dureePeineMois    Int?      @map("duree_peine_mois")
  decisionDapg      String?   @map("decision_dapg")
  dateDecisionDapg  DateTime? @map("date_decision_dapg")
  dureeTempsEpreuve String?   @map("duree_temps_epreuve")
  obligations       String? // texte brut DAPG — source d'extraction
  observations      String?
  othersData        Json?     @map("others_data")
  statut            String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  juridiction        Juridiction?  @relation(fields: [juridictionId], references: [id])
  beneficiaire       Beneficiaire? @relation("DossierToBeneficiaire")
  obligationsDossier Obligation[]
  documents          Document[]

  @@map("dossiers")
}

// =====================
// BENEFICIAIRE (couche technique)
// =====================

model Beneficiaire {
  id                                String    @id @default(uuid())
  dossierId                         String    @unique @map("dossier_id")
  statut                            String // statut technique existant
  profilStatut                      String    @default("A_CONFIGURER") @map("profil_statut") // A_CONFIGURER, ACTIF, REVOQUE
  biometrieEnrolementCode           String?   @unique @map("biometrie_enrolement_code")
  biometrieEnrolementStatut         String    @default("AUCUN") @map("biometrie_enrolement_statut") // AUCUN, EN_COURS, CONFIRME, ECHEC
  biometrieEnrolementDeepLinkFamoco String?   @map("biometrie_enrolement_deep_link_famoco")
  biometrieEnrolementApplication    String?   @map("biometrie_enrolement_application")
  biometrieEnrolementMany           String?   @map("biometrie_enrolement_many")
  biometrieEnrolementDemandeeLe     DateTime? @map("biometrie_enrolement_demandee_le")
  biometrieEnrolementConfirmeeLe    DateTime? @map("biometrie_enrolement_confirmee_le")
  biometrieVerificationEssais       Int       @default(0) @map("biometrie_verification_essais")
  biometrieDerniereVerificationLe   DateTime? @map("biometrie_derniere_verification_le")
  biometrieProchaineVerificationLe  DateTime? @map("biometrie_prochaine_verification_le")
  badgeNfc                          String?   @unique @map("badge_nfc")
  badgeNfcAssocieLe                 DateTime? @map("badge_nfc_associe_le")
  qrCode                            String    @unique @map("qr_code")
  profilConfirme                    Boolean   @default(false) @map("profil_confirme")
  profilConfirmeLe                  DateTime? @map("profil_confirme_le")
  createdAt                         DateTime  @default(now()) @map("created_at")

  dossier Dossier @relation("DossierToBeneficiaire", fields: [dossierId], references: [id])

  documents            Document[]
  obligations          Obligation[]
  pointages            Pointage[]
  demandesAutorisation DemandeAutorisation[]
  justificatifs        Justificatif[]
  alertes              Alerte[]
  notifications        Notification[]
  rapports             Rapport[]
  affectationsBracelet AffectationBracelet[]
  positionsGPS         PositionGPS[]
  zones                Zone[]
  reglesHoraires       RegleHoraire[]
  reglesSurveillance   RegleSurveillance[]
  alertesSurveillance  AlerteSurveillance[]
  incidentsBracelet    IncidentBracelet[]
  historiquesStatut    HistoriqueStatut[]

  @@map("beneficiaires")
}

// =====================
// DOCUMENT
// =====================

model Document {
  id             String    @id @default(uuid())
  beneficiaireId String    @map("beneficiaire_id")
  dossierId      String    @map("dossier_id")
  typeDocument   String    @map("type_document")
  titre          String
  description    String?
  source         String
  statut         String
  fileName       String?   @map("file_name")
  mimeType       String?   @map("mime_type")
  sizeBytes      Int?      @map("size_bytes")
  bucket         String
  objectKey      String    @unique @map("object_key")
  externalUrl    String?   @map("external_url")
  uploadedAt     DateTime? @map("uploaded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  beneficiaire Beneficiaire @relation(fields: [beneficiaireId], references: [id])
  dossier      Dossier      @relation(fields: [dossierId], references: [id])

  @@index([beneficiaireId, createdAt(sort: Desc)])
  @@map("documents")
}

// =====================
// CATEGORIE OBLIGATION
// =====================

model CategorieObligation {
  id          String  @id @default(uuid())
  nom         String // POINTAGE, COUVRE_FEU, INTERDICTION_ZONE, SUIVI_MEDICAL
  description String?

  obligations Obligation[]

  @@map("categories_obligations")
}

// =====================
// OBLIGATION
// =====================

model Obligation {
  id                  String    @id @default(uuid())
  beneficiaireId      String    @map("beneficiaire_id")
  dossierId           String    @map("dossier_id")
  categorieId         String    @map("categorie_id")
  source              String? // DAPG_SPECIFIC, DAPG_RAW, MANUAL
  description         String? // texte brut extrait de Dossier.obligations
  type                String? // POINTAGE, COUVRE_FEU, INTERDICTION_ZONE...
  frequence           String? // QUOTIDIEN, HEBDOMADAIRE, MENSUEL...
  jourSemaine         String?   @map("jour_semaine")
  heure               DateTime? @db.Time
  lieu                String?
  metadata            Json?
  statutStructuration String?   @map("statut_structuration") // NON_STRUCTUREE, A_VERIFIER, VALIDE
  dateDebut           DateTime? @map("date_debut") @db.Date
  dateFin             DateTime? @map("date_fin") @db.Date
  statut              String? // EN_COURS, RESPECTEE, NON_RESPECTEE, SUSPENDUE
  raisonModification  String?   @map("raison_modification")
  raisonAutre         String?   @map("raison_autre")
  modifieLe           DateTime? @map("modifie_le")
  modifiePar          String?   @map("modifie_par")
  createdAt           DateTime  @default(now()) @map("created_at")

  beneficiaire   Beneficiaire        @relation(fields: [beneficiaireId], references: [id])
  dossier        Dossier             @relation(fields: [dossierId], references: [id])
  categorie      CategorieObligation @relation(fields: [categorieId], references: [id])
  modifieParUser User?               @relation("ObligationModifiePar", fields: [modifiePar], references: [id])
  pointages      Pointage[]
  reglesHoraires RegleHoraire[]

  @@map("obligations")
}

// =====================
// POINTAGE
// =====================

model Pointage {
  id              String   @id @default(uuid())
  beneficiaireId  String   @map("beneficiaire_id")
  obligationId    String?  @map("obligation_id")
  agentId         String?  @map("agent_id")
  dateHeure       DateTime @map("date_heure")
  lieu            String?
  nfc             String?  @map("nfc")
  centreNom       String?  @map("centre_nom")
  deviceId        String?  @map("device_id")
  type            String // QR_CODE, BIOMETRIE, VALIDATION_AGENT
  statut          String // VALIDE, REFUSE, ABSENT, ANOMALIE
  source          String   @default("SYSTEME") // SYSTEME, FAMOCO, MANUEL
  externalSuccess Boolean? @map("external_success")
  externalPayload Json?    @map("external_payload")
  commentaire     String?

  beneficiaire  Beneficiaire   @relation(fields: [beneficiaireId], references: [id])
  obligation    Obligation?    @relation(fields: [obligationId], references: [id])
  agent         User?          @relation(fields: [agentId], references: [id])
  notifications Notification[]

  @@map("pointages")
}

// =====================
// DEMANDE AUTORISATION
// =====================

model DemandeAutorisation {
  id             String    @id @default(uuid())
  beneficiaireId String    @map("beneficiaire_id")
  type           String // DEPLACEMENT, ABSENCE, AUTRE
  motif          String?
  dateDebut      DateTime  @map("date_debut")
  dateFin        DateTime  @map("date_fin")
  statut         String // EN_ATTENTE, APPROUVEE, REFUSEE
  traiteepar     String?   @map("traitee_par")
  dateTraitement DateTime? @map("date_traitement")
  commentaire    String?
  createdAt      DateTime  @default(now()) @map("created_at")

  beneficiaire Beneficiaire @relation(fields: [beneficiaireId], references: [id])
  traitePar    User?        @relation(fields: [traiteepar], references: [id])

  @@map("demandes_autorisation")
}

// =====================
// JUSTIFICATIF
// =====================

model Justificatif {
  id             String    @id @default(uuid())
  beneficiaireId String    @map("beneficiaire_id")
  type           String // TRAVAIL, FORMATION, MEDICAL, AUTRE
  fichierUrl     String?   @map("fichier_url")
  statut         String // EN_ATTENTE, VALIDE, REJETE
  validePar      String?   @map("valide_par")
  dateValidation DateTime? @map("date_validation")
  commentaire    String?

  beneficiaire Beneficiaire @relation(fields: [beneficiaireId], references: [id])
  validateur   User?        @relation(fields: [validePar], references: [id])

  @@map("justificatifs")
}

// =====================
// ALERTE
// =====================

model Alerte {
  id             String   @id @default(uuid())
  beneficiaireId String   @map("beneficiaire_id")
  type           String // ABSENCE_POINTAGE, SORTIE_ZONE, RETRAIT_BRACELET, BATTERIE_FAIBLE, POWER_FAIL
  niveau         String // CRITIQUE, NORMALE
  message        String
  source         String // SYSTEME, AGENT, BRACELET
  statut         String // OUVERTE, TRAITEE, IGNOREE
  createdAt      DateTime @default(now()) @map("created_at")

  beneficiaire  Beneficiaire   @relation(fields: [beneficiaireId], references: [id])
  notifications Notification[]

  @@map("alertes")
}

// =====================
// NOTIFICATION
// =====================

model Notification {
  id             String    @id @default(uuid())
  userId         String?   @map("user_id")
  beneficiaireId String?   @map("beneficiaire_id")
  alerteId       String?   @map("alerte_id")
  pointageId     String?   @map("pointage_id")
  type           String // NOUVEAU_BENEFICIAIRE, BIOMETRIE_CONFIGUREE, SORTIE_ZONE...
  priorite       String // CRITIQUE, NORMALE, INFO
  targetType     String    @map("target_type")
  targetId       String    @map("target_id")
  canal          String // INTERFACE, EMAIL, SMS
  message        String
  statut         String // ENVOYE, ECHEC, EN_ATTENTE
  lu             Boolean   @default(false)
  metadata       Json?     @map("metadata")
  dateEnvoi      DateTime? @map("date_envoi")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id])
  beneficiaire Beneficiaire? @relation(fields: [beneficiaireId], references: [id])
  alerte       Alerte?       @relation(fields: [alerteId], references: [id])
  pointage     Pointage?     @relation(fields: [pointageId], references: [id])

  @@index([lu, createdAt])
  @@index([targetType, targetId])
  @@map("notifications")
}

// =====================
// RAPPORT
// =====================

model Rapport {
  id             String   @id @default(uuid())
  beneficiaireId String   @map("beneficiaire_id")
  generepar      String   @map("genere_par")
  type           String // MENSUEL, URGENCE, VISITE
  fichierUrl     String?  @map("fichier_url")
  createdAt      DateTime @default(now()) @map("created_at")

  beneficiaire Beneficiaire @relation(fields: [beneficiaireId], references: [id])
  generePar    User         @relation(fields: [generepar], references: [id])

  @@map("rapports")
}

// =====================
// BRACELET
// =====================

model Bracelet {
  id                 String    @id @default(uuid())
  codeImei           String    @unique @map("code_imei") // = device_id payload IoT
  identifiantPorteur String?   @map("identifiant_porteur") // = user_id payload IoT (ex: "DET-2024-883")
  numeroSim          String?   @map("numero_sim")
  modele             String?
  fabricant          String?
  statut             String // DISPONIBLE, AFFECTE, EN_PANNE, RETIRE
  dateActivation     DateTime? @map("date_activation")
  dernierSignalLe    DateTime? @map("dernier_signal_le")
  dernierePositionLe DateTime? @map("derniere_position_le")
  statutConnexion    String?   @map("statut_connexion") // EN_LIGNE, HORS_LIGNE, INCONNU

  affectations        AffectationBracelet[]
  positionsGPS        PositionGPS[]
  reglesSurveillance  RegleSurveillance[]
  alertesSurveillance AlerteSurveillance[]
  incidents           IncidentBracelet[]

  @@map("bracelets")
}

model AffectationBracelet {
  id             String    @id @default(uuid())
  braceletId     String    @map("bracelet_id")
  beneficiaireId String    @map("beneficiaire_id")
  dateDebut      DateTime  @map("date_debut")
  dateFin        DateTime? @map("date_fin")

  bracelet     Bracelet     @relation(fields: [braceletId], references: [id])
  beneficiaire Beneficiaire @relation(fields: [beneficiaireId], references: [id])

  @@map("affectations_bracelets")
}

// =====================
// POSITION GPS
// =====================
// ⚡ Activer TimescaleDB après migration :
//    SELECT create_hypertable('positions_gps', 'date_heure');
// Index composite déjà défini ci-dessous.

model PositionGPS {
  id               String  @id @default(uuid())
  braceletId       String  @map("bracelet_id")
  beneficiaireId   String  @map("beneficiaire_id")
  porteurExterneId String? @map("porteur_externe_id")

  // Bloc localisation
  latitude       Decimal
  longitude      Decimal
  precision      Decimal? @map("precision_m")
  accuracyMeters Int?     @map("accuracy_meters")
  presenceFlag   Boolean? @map("presence_flag") // bracelet en contact avec son boîtier
  rssiDbm        Int?     @map("rssi_dbm") // puissance signal RF
  zoneExterneId  String?  @map("zone_externe_id")
  zoneStatus     String?  @map("zone_status") // INSIDE, OUTSIDE, TRANSITION

  // Bloc santé
  batterie      Int?    @map("battery_pct") // battery_pct %
  powerSource   String? @map("power_source") // "battery" | "mains"
  gprsSignal    Int?    @map("gprs_signal")
  gpsSatellites Int?    @map("gps_satellites")

  // Bloc alertes
  strapStatus    Int?     @map("strap_status") // 0 = intact | 1 = boucle coupée
  caseTamper     Boolean? @map("case_tamper")
  geofenceBreach Boolean? @map("geofence_breach")
  gpsLost        Boolean? @map("gps_lost")
  gprsLost       Boolean? @map("gprs_lost")
  powerLoss      Boolean? @map("power_loss")

  // Résumé état — valeurs CDC : OK | TAMPER | ZONE_EXIT | LOW_BATTERY | POWER_FAIL
  statutBracelet String?  @map("statut_bracelet")
  heartbeat      Boolean?
  rawPayload     Json?    @map("raw_payload")

  // Note V1 : latitude/longitude = coordonnées fixes du domicile
  // pas de vrai GPS avant V2
  dateHeure DateTime @map("date_heure")

  bracelet            Bracelet             @relation(fields: [braceletId], references: [id])
  beneficiaire        Beneficiaire         @relation(fields: [beneficiaireId], references: [id])
  alertesSurveillance AlerteSurveillance[]

  @@index([braceletId, dateHeure(sort: Desc)])
  @@map("positions_gps")
}

// =====================
// REGLE SURVEILLANCE
// =====================

model RegleSurveillance {
  id             String   @id @default(uuid())
  beneficiaireId String?  @map("beneficiaire_id")
  braceletId     String?  @map("bracelet_id")
  type           String // SORTIE_ZONE, BATTERIE_FAIBLE, PERTE_SIGNAL, TAMPER, POWER_FAIL
  seuil          Float?
  unite          String? // %, minutes, metres, etc.
  severite       String // CRITIQUE, NORMALE
  actif          Boolean  @default(true)
  parametres     Json?
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  beneficiaire Beneficiaire?        @relation(fields: [beneficiaireId], references: [id], onDelete: SetNull)
  bracelet     Bracelet?            @relation(fields: [braceletId], references: [id], onDelete: SetNull)
  alertes      AlerteSurveillance[]

  @@index([beneficiaireId, actif])
  @@index([braceletId, actif])
  @@map("regles_surveillance")
}

// =====================
// ALERTE SURVEILLANCE
// =====================

model AlerteSurveillance {
  id                  String    @id @default(uuid())
  beneficiaireId      String    @map("beneficiaire_id")
  braceletId          String?   @map("bracelet_id")
  regleSurveillanceId String?   @map("regle_surveillance_id")
  positionGPSId       String?   @map("position_gps_id")
  type                String // SORTIE_ZONE, BATTERIE_FAIBLE, PERTE_SIGNAL, TAMPER, POWER_FAIL, CONFIGURATION
  niveau              String // CRITIQUE, NORMALE
  message             String
  source              String // SYSTEME, AGENT, BRACELET, SIMULATEUR
  statut              String // OUVERTE, TRAITEE, IGNOREE
  actionRecommandee   String?   @map("action_recommandee")
  metadata            Json?
  declencheeLe        DateTime  @default(now()) @map("declenchee_le")
  resolueLe           DateTime? @map("resolue_le")

  beneficiaire      Beneficiaire       @relation(fields: [beneficiaireId], references: [id], onDelete: Cascade)
  bracelet          Bracelet?          @relation(fields: [braceletId], references: [id], onDelete: SetNull)
  regleSurveillance RegleSurveillance? @relation(fields: [regleSurveillanceId], references: [id], onDelete: SetNull)
  positionGPS       PositionGPS?       @relation(fields: [positionGPSId], references: [id], onDelete: SetNull)

  @@index([beneficiaireId, declencheeLe(sort: Desc)])
  @@index([statut, niveau])
  @@map("alertes_surveillance")
}

// =====================
// ZONE
// =====================

model Zone {
  id             String @id @default(uuid())
  beneficiaireId String @map("beneficiaire_id")
  nom            String
  type           String // AUTORISEE, INTERDITE
  geometrie      Json? // → geometry PostGIS en production
  rayon          Int? // mètres — zones circulaires

  beneficiaire Beneficiaire @relation(fields: [beneficiaireId], references: [id])

  @@map("zones")
}

// =====================
// REGLE HORAIRE
// =====================

model RegleHoraire {
  id             String   @id @default(uuid())
  beneficiaireId String   @map("beneficiaire_id")
  obligationId   String   @map("obligation_id")
  jourSemaine    String   @map("jour_semaine")
  heureDebut     DateTime @map("heure_debut") @db.Time
  heureFin       DateTime @map("heure_fin") @db.Time
  type           String // PRESENCE_OBLIGATOIRE, COUVRE_FEU

  beneficiaire Beneficiaire @relation(fields: [beneficiaireId], references: [id])
  obligation   Obligation   @relation(fields: [obligationId], references: [id])

  @@map("regles_horaires")
}

// =====================
// INCIDENT BRACELET
// =====================

model IncidentBracelet {
  id             String   @id @default(uuid())
  beneficiaireId String   @map("beneficiaire_id")
  braceletId     String   @map("bracelet_id")
  type           String // RETRAIT, PERTE_SIGNAL, BATTERIE_FAIBLE, ANOMALIE, POWER_FAIL
  description    String?
  dateHeure      DateTime @map("date_heure")
  statut         String // OUVERT, TRAITE, CLOS

  beneficiaire Beneficiaire @relation(fields: [beneficiaireId], references: [id])
  bracelet     Bracelet     @relation(fields: [braceletId], references: [id])

  @@map("incidents_bracelet")
}

// =====================
// HISTORIQUE GLOBAL (AUDIT TRAIL)
// =====================

model HistoriqueAction {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  action         String // CREATE, UPDATE, DELETE, LOGIN...
  entite         String // nom de la table concernée
  entiteId       String   @map("entite_id")
  description    String?
  ancienneValeur Json?    @map("ancienne_valeur")
  nouvelleValeur Json?    @map("nouvelle_valeur")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  dateAction     DateTime @default(now()) @map("date_action")

  user User @relation(fields: [userId], references: [id])

  @@map("historique_actions")
}

// =====================
// HISTORIQUE STATUT
// =====================

model HistoriqueStatut {
  id             String   @id @default(uuid())
  beneficiaireId String   @map("beneficiaire_id")
  ancienStatut   String   @map("ancien_statut")
  nouveauStatut  String   @map("nouveau_statut")
  date           DateTime @default(now())

  beneficiaire Beneficiaire @relation(fields: [beneficiaireId], references: [id])

  @@map("historique_statuts")
}

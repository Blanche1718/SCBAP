# API Configuration
# Point to your backend API server
VITE_API_URL=http://localhost:3000

# WebSocket Configuration
# Used for real-time surveillance GPS tracking and alerts
VITE_SURVEILLANCE_WS_URL=ws://localhost:3000

# Application Settings
VITE_APP_TIME_ZONE=Africa/Porto-Novo

# Feature Flags (optional)
# VITE_FEATURE_ADVANCED_REPORTING=true
# VITE_FEATURE_BATCH_OPERATIONS=true

# Debug Mode (development only)
# VITE_DEBUG=false

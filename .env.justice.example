# Copier ce fichier en `.env` sur le serveur de la Justice avant de lancer Docker.
# Ne jamais committer le fichier `.env` réel.

# Domaine ou adresse d'acces utilisateur.
# Exemple intranet: http://10.10.20.50:8080
# Exemple domaine HTTPS: https://scbap.justice.bj

PUBLIC_APP_URL=https://DOMAINE_JUSTICE
PUBLIC_HTTP_PORT=8080
PUBLIC_WS_URL=
HTTPS=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Base de donnees interne Docker
POSTGRES_DB=change_me
POSTGRES_USER=change_me
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# Redis interne Docker
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# MinIO interne Docker
MINIO_ROOT_USER=CHANGE_ME_STRONG_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=scbap-documents
MINIO_REGION=us-east-1
MINIO_CONSOLE_PORT=9001


# JWT secrets
JWT_SECRET=1Zx2rraFPqiu5Uuis2Wn0sIZgLXrR_i0LtMDVE7esbV4BpIlv6l0UQZDLaoY-BsD
PORTAIL_JWT_SECRET=1Zx2rraFPqiu5Uuis2Wn0sIZgLXrR_i0LtMDVE7esbV4BpIlv6l0UQZDLaoY-BsD
JWT_EXPIRES_IN=12h
PORTAIL_JWT_EXPIRES_IN=12h

# Authentification
BCRYPT_ROUNDS=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_COOKIE_NAME=scbap_session
AUTH_COOKIE_MAX_AGE_MS=43200000

# API DAPG accessible depuis le reseau Justice
DAPG_BASE_URL=https://pprod-amenagementdepeine.justice.bj/api
DAPG_API_KEY=fa9d1f3c6a4e02b7fa5c3d9fa6b4e7fa3c1d9f5a6b

# Services externes Justice
BIOMETRIE_API_BASE_URL=http://pprod-fingerprints.justice.bj
BIOMETRIE_API_KEY=7aa22545215d6026610b64e44a5698a51282efa558aed737c77eba8df20586f7
BIOMETRIE_APPLICATION=siope
BIOMETRIE_DEEP_LINK_APP=
BIOMETRIE_MANY=no
BIOMETRIE_TIMEOUT_MS=30000
BIOMETRIE_DEBUG=false
NFC_DETENUS_URL=http://172.17.57.95:50049/api/detenus/all
NFC_TIMEOUT_MS=60000

# MQTT bracelet. Laisser vide si pas encore utilise.
MQTT_BROKER_URL=
MQTT_CLIENT_ID=scbap-backend-prod
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=scbap/bracelets/telemetry
MQTT_EVENTS_TOPIC=scbap/bracelets/events
MQTT_STATUS_TOPIC=scbap/bracelets/status
MQTT_CONFIG_TOPIC=scbap/bracelets/config
MQTT_DEBUG=false

# Mail. Peut rester vide si l'envoi mail n'est pas encore active.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=SCBAP
MAIL_REPLY_TO=

# Divers
APP_TIME_ZONE=Africa/Porto-Novo
LOG_LEVEL=info
